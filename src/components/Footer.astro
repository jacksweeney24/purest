---
import siteConfig from "@/data/site-config.json";
import Logo from "@/components/Logo.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-border/60 bg-secondary">
  <div class="container py-12">
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-5">

      <!-- Brand -->
      <div class="space-y-3 md:col-span-1">
        <Logo className="h-7" />
        <p class="text-sm text-muted-foreground">{siteConfig.brand.tagline}</p>
      </div>

      <!-- Shop -->
      <div class="space-y-3">
        <h4 class="text-sm font-medium uppercase tracking-widest">Shop</h4>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li><a href="/products" class="hover:text-foreground transition-colors">All Flavors</a></li>
          <li><a href="/products/the-hydration-ritual-kit" class="hover:text-foreground transition-colors">The Hydration Ritual Kit</a></li>
          <li><a href="/products/5-day-hydration-kit" class="hover:text-foreground transition-colors">5 Day Hydration Kit</a></li>
          <li><a href="/products/10-count-ginger-limeaid" class="hover:text-foreground transition-colors">Ginger Limeaid</a></li>
          <li><a href="/products/10-count-hibiscus-lime" class="hover:text-foreground transition-colors">Hibiscus Lime</a></li>
          <li><a href="/products/10-serving-passion-cherry" class="hover:text-foreground transition-colors">Passion Cherry</a></li>
          <li><a href="/products/10-servings-cranberry" class="hover:text-foreground transition-colors">Cranberry</a></li>
          <li><a href="/products/10-count-chocolate-cordyceps-1" class="hover:text-foreground transition-colors">Chocolate Cordyceps</a></li>
        </ul>
      </div>

      <!-- About -->
      <div class="space-y-3">
        <h4 class="text-sm font-medium uppercase tracking-widest">About</h4>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li><a href="/about" class="hover:text-foreground transition-colors">Our Story</a></li>
          <li><a href="/why-french-gray-sea-salt" class="hover:text-foreground transition-colors">Why French Gray Sea Salt</a></li>
          <li><a href="/real-ingredients" class="hover:text-foreground transition-colors">Real Ingredients</a></li>
        </ul>
      </div>

      <!-- Partners -->
      <div class="space-y-3">
        <h4 class="text-sm font-medium uppercase tracking-widest">Partners</h4>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li><a href="/affiliate" class="hover:text-foreground transition-colors">Brand Partner Program</a></li>
        </ul>
      </div>

      <!-- Connect -->
      <div class="space-y-3">
        <h4 class="text-sm font-medium uppercase tracking-widest">Connect</h4>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li>
            <a
              href={siteConfig.footer.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-foreground transition-colors"
            >Instagram</a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.footer.email}`} class="hover:text-foreground transition-colors">Contact Us</a>
          </li>

          <li>
            <a
              href="https://purestelectrolyte.myshopify.com/tools/recurring/login"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-foreground transition-colors"
            >Manage My Subscription</a>
          </li>
        </ul>
      </div>

    </div>

    <div class="mt-10 border-t border-border/40 pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-sm text-muted-foreground">
      <span>© {year} {siteConfig.brand.name}. All rights reserved.</span>
      <a href={`mailto:${siteConfig.footer.email}`} class="hover:text-foreground transition-colors">{siteConfig.footer.email}</a>
    </div>
  </div>
</footer>
