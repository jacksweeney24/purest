---
/*
 * Reusable logo component.
 *
 * Uses the approved singular PUREST ELECTROLYTE wordmark.
 * The image has a 1524×493 aspect ratio, so both intrinsic dimensions are set
 * and the browser can scale it without layout shift while Tailwind controls
 * its displayed height.
 *
 * Source aspect ratio: 1524 / 493 ≈ 3.091.
 */

interface Props {
  /** Tailwind height class, e.g. "h-7". Width is derived from the aspect ratio. */
  className?: string;
  /** Alt text for accessibility. Defaults to the brand name. */
  alt?: string;
}

const { className = "h-7", alt = "Purest Electrolyte" } = Astro.props;
---

<img
    src="/images/purest-logo.png"
    alt={alt}
    width="1524"
    height="493"
    class:list={["w-auto max-w-[100px] sm:max-w-[120px]", className]}
    loading="eager"
    decoding="async"
    style="object-fit: contain;"
  />
