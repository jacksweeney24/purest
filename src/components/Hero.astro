---
import siteConfig from "@/data/site-config.json";

const { cta, ctaHref, image, imageFallback, imageAlt } = siteConfig.hero;
---

<section class="w-full bg-stone-50 overflow-hidden">
  <picture class="relative block aspect-[2048/1185] w-full overflow-hidden">
    <source srcset={image} type="image/webp" />
    <img
      src={imageFallback}
      alt={imageAlt}
      class="absolute inset-0 h-full w-full object-cover object-bottom"
      loading="eager"
      fetchpriority="high"
    />
  </picture>

  <div class="border-t border-foreground/10">
    <div class="container py-6 sm:py-8 md:py-10 lg:py-12">
      <div class="grid gap-6 md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] md:gap-12 lg:gap-20">
        <div class="max-w-xl">
          <div class="text-sm text-foreground/60">
            Loved by athletes, parents & everyday hydrators
          </div>

          <h1 class="mt-4 font-serif text-[2.55rem] leading-[0.96] tracking-tight sm:text-5xl md:text-6xl lg:text-7xl">
            Your new<br /><em>hydration ritual.</em>
          </h1>
        </div>

        <div class="max-w-xl md:self-end">
          <ul class="space-y-2 text-sm text-foreground/75 md:text-base">
            <li class="flex items-start gap-2"><span class="font-bold text-green-600">✓</span> 85+ trace minerals from natural sun-dried sea salt</li>
            <li class="flex items-start gap-2"><span class="font-bold text-green-600">✓</span> 700+ mg naturally occurring sodium — no synthetic salt</li>
            <li class="flex items-start gap-2"><span class="font-bold text-green-600">✓</span> 0 added sugar, 0 anti-caking agents, 0 maltodextrin</li>
          </ul>

          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a
              href="#shop"
              class="inline-flex h-[52px] items-center justify-center rounded-full bg-primary px-10 text-base font-medium text-primary-foreground transition-all duration-150 hover:bg-primary/90 active:scale-[0.98]"
            >
              Shop now →
            </a>
            <a
              href="/products/5-day-hydration-kit"
              class="inline-flex h-[52px] items-center justify-center rounded-full border border-foreground/20 px-8 text-base font-medium text-foreground transition-all hover:bg-foreground/5"
            >
              Try the 5-Day Kit — $15.99
            </a>
          </div>

          <p class="mt-4 text-xs text-foreground/40">Free shipping on orders over $39</p>
        </div>
      </div>
    </div>
  </div>
</section>
