---
import siteConfig from "@/data/site-config.json";

const { cta, ctaHref, image, imageFallback, imageAlt } = siteConfig.hero;
---

{/*
 * Split hero: text left, product image right — LMNT-style layout.
 * Purest's light, airy brand feel instead of LMNT's dark aesthetic.
 */}
<section class="w-full bg-stone-50 overflow-hidden">
  <div class="container">
    <div class="grid md:grid-cols-2 min-h-[480px] md:min-h-[560px] items-center gap-8 py-12 md:py-0">

      {/* Left: headline + description + CTA — order-2 on mobile so image shows first */}
      <div class="space-y-3 py-4 md:py-8 order-2 md:order-1">

        {/* How's Your hook */}
        <p class="text-sm font-medium tracking-wide text-foreground/50 uppercase">How's your health?</p>

        <h1 class="font-serif text-5xl leading-tight tracking-tight md:text-6xl lg:text-7xl">
          Where Wellness<br />Meets <em>Performance.</em>
        </h1>

        <p class="text-sm font-medium text-foreground/60 tracking-wider">Real Fruit. Real Salt.</p>

        {/* Benefit bullets */}
        <ul class="space-y-2 text-sm text-foreground/75">
          <li class="flex items-center gap-2"><span class="text-green-600 font-bold">✓</span> 85+ trace minerals from natural sun-dried sea salt</li>
          <li class="flex items-center gap-2"><span class="text-green-600 font-bold">✓</span> 700+ mg naturally occurring sodium — no synthetic salt</li>
          <li class="flex items-center gap-2"><span class="text-green-600 font-bold">✓</span> 0 added sugar, 0 artificial ingredients, nothing hidden</li>
        </ul>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="#shop"
            class="inline-flex h-14 items-center justify-center rounded-full bg-primary px-10 text-base font-medium text-primary-foreground transition-all duration-150 hover:bg-primary/90 active:scale-[0.98]"
          >
            Shop now →
          </a>
          <a
            href="/products/20-count-variety-pack"
            class="inline-flex h-14 items-center justify-center rounded-full border border-foreground/20 px-8 text-base font-medium text-foreground transition-all hover:bg-foreground/5"
          >
            Try the 5-Day Kit — $15.99
          </a>
        </div>

        <p class="text-xs text-foreground/40">Free shipping on orders over $45</p>
      </div>

      {/* Right: product image — order-1 on mobile so it shows first */}
      <div class="relative h-[360px] md:h-full md:min-h-[560px] -mx-4 md:mx-0 md:-mr-8 lg:-mr-16 order-1 md:order-2">
        <picture>
          <source srcset={image} type="image/webp" />
          <img
            src={imageFallback}
            alt={imageAlt}
            class="absolute inset-0 w-full h-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </div>

    </div>
  </div>
</section>
