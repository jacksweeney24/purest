---
// The base HTML layout. Every page uses this.
// Slots: default content, plus an optional "head" slot for page-specific meta tags.
import "@/styles/global.css";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Cart from "@/components/Cart.tsx";
import siteConfig from "@/data/site-config.json";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.brand.name,
  description = siteConfig.brand.tagline,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://www.purestelectrolyte.com").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/*
     * Fraunces — a variable serif with editorial / magazine character.
     * High contrast, flowing italics, and refined letterforms — same family
     * NYT Cooking, AD, and similar publications use for editorial headlines.
     *
     * The `opsz` (optical size) axis ranges 9–144 so the font self-tunes:
     * headlines get the display cut, smaller text gets the text cut.
     * Loading both upright and italic so we can use *italic emphasis* in
     * headlines (e.g. "and *so much more*").
     *
     * preconnect speeds up the connection to Google's CDN; display=swap
     * renders system serif first, then swaps in Fraunces once loaded.
     */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Structured Data for Google Search -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Purest Electrolyte",
      "url": "https://www.purestelectrolyte.com",
      "logo": "https://www.purestelectrolyte.com/images/purest-logo.png",
      "image": [
        "https://www.purestelectrolyte.com/images/product-lineup.jpg",
        "https://www.purestelectrolyte.com/images/ginger-lime-hero.jpg"
      ],
      "description": "Purest Electrolyte makes real fruit electrolyte powder packaged in clear glass jars with French gray sea salt and no natural flavors.",
      "sameAs": [
        "https://www.instagram.com/purestelectrolyte",
        "https://www.facebook.com/p/Purest-Electrolyte-61558585146763/"
      ]
    }
    </script>

    <!-- Open Graph / Social Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Purest Electrolyte" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.purestelectrolyte.com/images/product-lineup.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.purestelectrolyte.com/images/product-lineup.jpg" />

    <slot name="head" />

    <!-- Google Merchant Center Verification -->
    <meta name="google-site-verification" content="QaUav2TZR-JIWn7-7EvML2bWb2qUPgZzlccAqNicy7w" />

    <!-- Judge.me Reviews Widget -->
    <script type="text/javascript">
      var JudgemeShopDomain = 'purestelectrolyte.myshopify.com';
      var JudgemeShopPlatform = 'shopify';
    </script>
    <script type="text/javascript" src="https://cdn.judge.me/widget.js" async></script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PJ3W3KJBLF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PJ3W3KJBLF', {
        'send_page_view': true,
        'allow_enhanced_conversions': true
      });
      // GA4 ecommerce helper — fires view_item on product pages
      window.gtagViewItem = function(product) {
        gtag('event', 'view_item', {
          currency: 'USD',
          value: parseFloat(product.price) || 0,
          items: [{
            item_id: product.id,
            item_name: product.title,
            price: parseFloat(product.price) || 0,
            quantity: 1
          }]
        });
      };
      window.gtagAddToCart = function(product, quantity) {
        gtag('event', 'add_to_cart', {
          currency: 'USD',
          value: (parseFloat(product.price) || 0) * (quantity || 1),
          items: [{
            item_id: product.id,
            item_name: product.title,
            price: parseFloat(product.price) || 0,
            quantity: quantity || 1
          }]
        });
      };
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {/*
     * The Cart drawer is mounted once at the layout level so it's available
     * from any page. `client:load` hydrates immediately on page load so the
     * cart's persisted state is visible right away.
     */}
    <Cart client:load />

    <!-- Email capture pop-up -->
    <div id="email-popup" class="fixed inset-0 z-50 hidden items-center justify-center p-4" style="background:rgba(0,0,0,0.55);backdrop-filter:blur(2px)">
      <div class="relative bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden">
        <!-- Close -->
        <button id="popup-close" class="absolute top-4 right-4 text-stone-400 hover:text-stone-700 text-xl w-8 h-8 flex items-center justify-center" aria-label="Close">&times;</button>

        <!-- Hero image strip -->
        <div class="h-40 bg-stone-100 overflow-hidden">
          <img src="/images/lifestyle-all-flavors.jpg" alt="Purest Electrolyte" class="w-full h-full object-cover object-center" />
        </div>

        <!-- Content -->
        <div class="px-8 py-7">
          <div class="text-center mb-5">
            <div class="inline-block bg-amber-50 text-amber-800 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-3">Limited Time</div>
            <h2 class="font-serif text-2xl text-stone-900 leading-snug">Get 10% off your<br/>first order</h2>
            <p class="text-stone-500 text-sm mt-2">Real fruit. Real salt. Nothing else.<br/>Join thousands of athletes who already switched.</p>
          </div>

          <form id="popup-form" class="space-y-3">
            <input
              type="email"
              id="popup-email"
              placeholder="Your email address"
              required
              class="w-full border border-stone-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-stone-400"
            />
            <button
              type="submit"
              id="popup-submit"
              class="w-full bg-stone-900 text-white rounded-lg px-4 py-3 text-sm font-semibold hover:bg-stone-700 transition-colors"
            >
              Claim my 10% off
            </button>
          </form>

          <!-- Success state (hidden initially) -->
          <div id="popup-success" class="hidden text-center py-2">
            <div class="text-3xl mb-2">📬</div>
            <div class="font-serif font-semibold text-stone-900 text-lg">Check your inbox!</div>
            <div class="text-stone-500 text-sm mt-2 leading-relaxed">Your 10% off code is on its way.<br/>Click the link in your email to confirm<br/>and grab your discount.</div>
            <button id="popup-shop" class="mt-5 w-full bg-stone-900 text-white rounded-lg px-4 py-3 text-sm font-semibold hover:bg-stone-700 transition-colors">
              Got it &rarr;
            </button>
          </div>

          <p class="text-center text-xs text-stone-400 mt-4">No spam. Unsubscribe anytime.</p>
        </div>
      </div>
    </div>

    <script>
      (function() {
        const STORAGE_KEY = 'purest_popup_dismissed';
        const DELAY_MS = 10000; // 10 seconds
        const popup = document.getElementById('email-popup');
        const closeBtn = document.getElementById('popup-close');
        const form = document.getElementById('popup-form');
        const successDiv = document.getElementById('popup-success');
        const shopBtn = document.getElementById('popup-shop');
        const submitBtn = document.getElementById('popup-submit') as HTMLButtonElement | null;

        // Don't show if already dismissed or subscribed
        if (localStorage.getItem(STORAGE_KEY)) return;

        // Don't interrupt pages with their own form or signup experience
        const noPopupPaths = ['/contact', '/aspenmarathon', '/lajolla'];
        if (noPopupPaths.some(p => window.location.pathname.startsWith(p))) return;

        function showPopup() {
          if (!popup) return;
          popup.classList.remove('hidden');
          popup.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        function hidePopup() {
          if (!popup) return;
          popup.classList.add('hidden');
          popup.classList.remove('flex');
          document.body.style.overflow = '';
          localStorage.setItem(STORAGE_KEY, '1');
        }

        // Show after delay
        setTimeout(showPopup, DELAY_MS);

        // Close on X
        closeBtn?.addEventListener('click', hidePopup);

        // Close on backdrop
        popup?.addEventListener('click', (e) => {
          if (e.target === popup) hidePopup();
        });

        // Form submit
        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = (document.getElementById('popup-email') as HTMLInputElement)?.value?.trim();
          if (!email) return;

          if (submitBtn) {
            submitBtn.textContent = 'Subscribing...';
            submitBtn.disabled = true;
          }

          try {
            // Klaviyo client-side subscribe (public API key: TYfncY, list: WapMkg = Email List)
            await fetch('https://a.klaviyo.com/client/subscriptions/?company_id=TYfncY', {
              method: 'POST',
              headers: { 'content-type': 'application/json', 'revision': '2023-12-15' },
              body: JSON.stringify({
                data: {
                  type: 'subscription',
                  attributes: {
                    custom_source: 'Website Pop-up',
                    profile: {
                      data: {
                        type: 'profile',
                        attributes: { email, properties: { source: 'popup', discount_code: 'WELCOME10' } }
                      }
                    }
                  },
                  relationships: {
                    list: { data: { type: 'list', id: 'WapMkg' } }
                  }
                }
              })
            });
          } catch (_) {
            // Silently fail — still show success so user gets the code
          }

          // Show success
          form.classList.add('hidden');
          successDiv?.classList.remove('hidden');
          localStorage.setItem(STORAGE_KEY, '1');

          // GA event
          if (typeof window !== 'undefined' && (window as any).gtag) {
            (window as any).gtag('event', 'email_capture', { method: 'popup' });
          }
        });

        // Shop button
        shopBtn?.addEventListener('click', () => {
          hidePopup();
          window.location.href = '/products';
        });
      })();
    </script>
  </body>
</html>
