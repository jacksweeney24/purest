---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Affiliate Program — Purest Electrolyte" description="Earn 10% commission sharing Purest Electrolyte with your community. Your followers get 10% off, you get paid. Real fruit, real salt — products people actually love to share.">
  <section class="container py-20 max-w-3xl">

    <!-- Hero -->
    <header class="text-center mb-16">
      <p class="text-sm uppercase tracking-widest text-muted-foreground mb-4">Partner With Purest</p>
      <h1 class="font-serif text-4xl md:text-5xl font-medium mb-6">Share what you love.<br/>Get paid for it.</h1>
      <p class="text-lg text-muted-foreground max-w-xl mx-auto">
        If you're already telling people about Purest, you should be earning from it. Our affiliate program gives you a unique code, a real commission, and products you can actually stand behind.
      </p>
    </header>

    <!-- How It Works -->
    <div class="mb-16">
      <h2 class="font-serif text-2xl font-medium mb-8 text-center">How it works</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="bg-secondary border border-border rounded-xl p-6 text-center">
          <div class="text-3xl mb-3">✉️</div>
          <h3 class="font-semibold mb-2">1. Apply</h3>
          <p class="text-sm text-muted-foreground">Fill out a quick application. We review within 3–5 days and send you a welcome kit.</p>
        </div>
        <div class="bg-secondary border border-border rounded-xl p-6 text-center">
          <div class="text-3xl mb-3">🔗</div>
          <h3 class="font-semibold mb-2">2. Share</h3>
          <p class="text-sm text-muted-foreground">Get your personal discount code and link. Your followers save 10% — you earn on every order they place.</p>
        </div>
        <div class="bg-secondary border border-border rounded-xl p-6 text-center">
          <div class="text-3xl mb-3">💸</div>
          <h3 class="font-semibold mb-2">3. Earn</h3>
          <p class="text-sm text-muted-foreground">Earn 10% commission on every sale. Payouts monthly via PayPal or Venmo — no minimums to start.</p>
        </div>
      </div>
    </div>

    <!-- Perks -->
    <div class="mb-16 bg-secondary border border-border rounded-xl px-8 py-10">
      <h2 class="font-serif text-2xl font-medium mb-6">What you get</h2>
      <ul class="space-y-4 text-sm">
        <li class="flex items-start gap-3">
          <span class="text-foreground font-bold mt-0.5">✓</span>
          <div><strong>10% commission</strong> on every sale you drive</div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-foreground font-bold mt-0.5">✓</span>
          <div><strong>Your own discount code</strong> — your followers get 10% off, which makes it easy to share</div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-foreground font-bold mt-0.5">✓</span>
          <div><strong>Free starter kit</strong> shipped to you when you're approved — try it before you share it</div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-foreground font-bold mt-0.5">✓</span>
          <div><strong>30-day cookie</strong> — if your follower clicks your link and buys within 30 days, you earn</div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-foreground font-bold mt-0.5">✓</span>
          <div><strong>Early access</strong> to new flavors and products before they go public</div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-foreground font-bold mt-0.5">✓</span>
          <div><strong>Real support from Pam</strong> — this isn't a faceless program. You're working directly with the founder.</div>
        </li>
      </ul>
    </div>

    <!-- Who It's For -->
    <div class="mb-16">
      <h2 class="font-serif text-2xl font-medium mb-4">Who this is for</h2>
      <p class="text-muted-foreground mb-4">We partner with people who live an active lifestyle and actually care what goes into their body. You don't need a massive following — you need a real one.</p>
      <p class="text-muted-foreground">Bloggers, coaches, personal trainers, runners, hikers, yogis, health-focused creators — if your community trusts you, we want to work with you.</p>
    </div>

    <!-- Apply Form -->
    <div class="border border-border rounded-xl px-8 py-10">
      <h2 class="font-serif text-2xl font-medium mb-2">Ready to apply?</h2>
      <p class="text-muted-foreground text-sm mb-8">We review every application personally. You'll hear back within 3–5 business days.</p>

      <form id="affiliate-form" class="space-y-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-medium mb-1.5" for="aff-name">Your name</label>
            <input id="aff-name" name="name" type="text" required placeholder="Pam Sweeney"
              class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5" for="aff-email">Email address</label>
            <input id="aff-email" name="email" type="email" required placeholder="you@example.com"
              class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5" for="aff-handle">Your Instagram, TikTok, or website</label>
          <input id="aff-handle" name="social_handle" type="text" required placeholder="@yourhandle or yourwebsite.com"
            class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5" for="aff-message">Why do you want to partner with Purest?</label>
          <textarea id="aff-message" name="message" required rows="4" placeholder="Tell us about your community and how you'd share Purest..."
            class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20 resize-none"></textarea>
        </div>
        <button type="submit" id="aff-submit"
          class="w-full bg-foreground text-background font-semibold px-8 py-4 rounded-lg hover:opacity-80 transition-opacity">
          Submit Application →
        </button>
      </form>

      <div id="affiliate-success" class="hidden text-center py-8">
        <div class="text-3xl mb-3">🎉</div>
        <div class="font-serif text-xl font-medium mb-2">Application received!</div>
        <p class="text-muted-foreground text-sm">Thank you! Pam reviews every application personally and will be in touch within 3–5 days.</p>
      </div>
    </div>

    <script>
      const form = document.getElementById('affiliate-form');
      const success = document.getElementById('affiliate-success');
      const btn = document.getElementById('aff-submit');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.textContent = 'Submitting...';
        btn.setAttribute('disabled', 'true');

        const name = (document.getElementById('aff-name') as HTMLInputElement).value.trim();
        const email = (document.getElementById('aff-email') as HTMLInputElement).value.trim();
        const handle = (document.getElementById('aff-handle') as HTMLInputElement).value.trim();
        const message = (document.getElementById('aff-message') as HTMLTextAreaElement).value.trim();
        const firstName = name.split(' ')[0];
        const lastName = name.split(' ').slice(1).join(' ');

        try {
          await fetch('https://a.klaviyo.com/client/subscriptions/?company_id=TYfncY', {
            method: 'POST',
            headers: { 'content-type': 'application/json', 'revision': '2023-12-15' },
            body: JSON.stringify({
              data: {
                type: 'subscription',
                attributes: {
                  custom_source: 'Affiliate Application',
                  profile: {
                    data: {
                      type: 'profile',
                      attributes: {
                        email,
                        first_name: firstName,
                        last_name: lastName,
                        properties: {
                          application_type: 'affiliate',
                          social_handle: handle,
                          application_message: message,
                          application_date: new Date().toISOString().split('T')[0]
                        }
                      }
                    }
                  }
                },
                relationships: {
                  list: { data: { type: 'list', id: 'UwYEZd' } }
                }
              }
            })
          });
        } catch (_) {}

        form?.classList.add('hidden');
        success?.classList.remove('hidden');
      });
    </script>

  </section>
</Layout>
