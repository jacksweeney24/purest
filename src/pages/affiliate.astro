---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Brand Partner Program — Purest Electrolyte" description="Join the Purest Brand Partner Program. Earn commission, rep the brand, and be part of something real. Apply as an affiliate or an athlete ambassador.">
  <section class="container py-20 max-w-3xl">

    <!-- Hero -->
    <header class="text-center mb-16">
      <p class="text-sm uppercase tracking-widest text-muted-foreground mb-4">Brand Partner Program</p>
      <h1 class="font-serif text-4xl md:text-5xl font-medium mb-6">Share what you love.<br/>Be part of the brand.</h1>
      <p class="text-lg text-muted-foreground max-w-xl mx-auto mb-8">
        Whether you want to earn commission or go deeper as a brand ambassador — there's a place for you here. One application. Pam reviews every single one personally.
      </p>
      <a href="#apply" class="inline-block bg-foreground text-background font-semibold px-8 py-4 rounded-lg hover:opacity-80 transition-opacity">Apply Now &rarr;</a>
    </header>

    <!-- Two Tiers -->
    <div class="mb-16 grid gap-6 sm:grid-cols-2">
      <div class="bg-secondary border border-border rounded-xl p-8">
        <div class="text-3xl mb-4">🤝</div>
        <h2 class="font-serif text-xl font-medium mb-3">Affiliate Partner</h2>
        <p class="text-sm text-muted-foreground mb-5">You have an audience and want to earn from sharing Purest. Simple, commission-based, no minimums.</p>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start gap-2"><span class="font-bold mt-0.5">✓</span> 10% commission on every sale</li>
          <li class="flex items-start gap-2"><span class="font-bold mt-0.5">✓</span> Your own discount code (10% off for your followers)</li>
          <li class="flex items-start gap-2"><span class="font-bold mt-0.5">✓</span> Free starter kit when approved</li>
          <li class="flex items-start gap-2"><span class="font-bold mt-0.5">✓</span> 30-day cookie tracking</li>
          <li class="flex items-start gap-2"><span class="font-bold mt-0.5">✓</span> Monthly payouts via PayPal or Venmo</li>
        </ul>
      </div>
      <div class="bg-secondary border border-border rounded-xl p-8">
        <div class="text-3xl mb-4">🏅</div>
        <h2 class="font-serif text-xl font-medium mb-3">Athlete Council</h2>
        <p class="text-sm text-muted-foreground mb-5">You live this lifestyle for real. You want a deeper relationship — to help shape the brand, not just share it.</p>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start gap-2"><span class="font-bold mt-0.5">✓</span> Everything in Affiliate, plus:</li>
          <li class="flex items-start gap-2"><span class="font-bold mt-0.5">✓</span> Free monthly supply shipped to you</li>
          <li class="flex items-start gap-2"><span class="font-bold mt-0.5">✓</span> First access to new flavors & products</li>
          <li class="flex items-start gap-2"><span class="font-bold mt-0.5">✓</span> Featured on purestelectrolyte.com</li>
          <li class="flex items-start gap-2"><span class="font-bold mt-0.5">✓</span> Direct access to Pam — real collaboration</li>
        </ul>
      </div>
    </div>

    <!-- Who It's For -->
    <div class="mb-16">
      <h2 class="font-serif text-2xl font-medium mb-4">Who this is for</h2>
      <p class="text-muted-foreground mb-4 leading-relaxed">Runners. Skiers. Surfers. Hikers. Coaches. CrossFitters. Cyclists. Yogis. Beach athletes. Mountain athletes. Anyone who pushes their body and cares about what goes into it.</p>
      <p class="text-muted-foreground leading-relaxed">We don't require a certain follower count. We care about your values, your voice, and your community's trust in you. Some of our best partners have 2,000 followers and more influence than accounts with 200,000.</p>
    </div>

    <!-- Quote -->
    <div class="mb-16 border-l-2 border-border pl-6">
      <p class="text-lg font-serif italic text-foreground/80 leading-relaxed mb-3">
        "I started Purest because I couldn't find anything clean enough for my own kids. The people I want in this program are the ones who actually read the label."
      </p>
      <p class="text-sm text-muted-foreground">— Pam Sweeney, Founder</p>
    </div>

    <!-- Apply Form -->
    <div id="apply" class="border border-border rounded-xl px-8 py-10">
      <h2 class="font-serif text-2xl font-medium mb-2">Apply to the Brand Partner Program</h2>
      <p class="text-muted-foreground text-sm mb-8">Pam reviews every application personally and responds within 3–5 days.</p>

      <form id="partner-form" class="space-y-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-medium mb-1.5" for="p-name">Your name</label>
            <input id="p-name" name="name" type="text" required placeholder="Jane Smith"
              class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5" for="p-email">Email address</label>
            <input id="p-email" name="email" type="email" required placeholder="you@example.com"
              class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20" />
          </div>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-medium mb-1.5" for="p-handle">Instagram, TikTok, or website</label>
            <input id="p-handle" name="social_handle" type="text" required placeholder="@yourhandle or yoursite.com"
              class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5" for="p-sport">Your sport or activity</label>
            <input id="p-sport" name="sport" type="text" placeholder="Running, skiing, surfing..."
              class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20" />
          </div>
        </div>

        <!-- Partner Type -->
        <div>
          <label class="block text-sm font-medium mb-3">Which best describes you? <span class="text-muted-foreground">(you can check both)</span></label>
          <div class="space-y-3">
            <label class="flex items-start gap-3 cursor-pointer group">
              <input type="checkbox" id="p-type-affiliate" name="partner_type" value="affiliate"
                class="mt-0.5 w-4 h-4 rounded border-border accent-foreground" />
              <div>
                <span class="text-sm font-medium">🤝 Affiliate Partner</span>
                <p class="text-xs text-muted-foreground mt-0.5">I want to earn commission sharing Purest with my audience</p>
              </div>
            </label>
            <label class="flex items-start gap-3 cursor-pointer group">
              <input type="checkbox" id="p-type-council" name="partner_type" value="athlete_council"
                class="mt-0.5 w-4 h-4 rounded border-border accent-foreground" />
              <div>
                <span class="text-sm font-medium">🏅 Athlete Council</span>
                <p class="text-xs text-muted-foreground mt-0.5">I want a deeper brand relationship — test products, give feedback, help shape Purest</p>
              </div>
            </label>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-1.5" for="p-message">Tell us about yourself</label>
          <textarea id="p-message" name="message" required rows="4" placeholder="Tell us about your community, your active life, and why Purest fits..."
            class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20 resize-none"></textarea>
        </div>

        <button type="submit" id="p-submit"
          class="w-full bg-foreground text-background font-semibold px-8 py-4 rounded-lg hover:opacity-80 transition-opacity">
          Submit Application →
        </button>
      </form>

      <div id="partner-success" class="hidden text-center py-8">
        <div class="text-3xl mb-3">🎉</div>
        <div class="font-serif text-xl font-medium mb-2">Application received!</div>
        <p class="text-muted-foreground text-sm">Thank you! Pam reviews every application personally and will be in touch within 3–5 days.</p>
      </div>
    </div>

    <script>
      const form = document.getElementById('partner-form');
      const success = document.getElementById('partner-success');
      const btn = document.getElementById('p-submit') as HTMLButtonElement;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.textContent = 'Submitting...';
        btn.setAttribute('disabled', 'true');

        const name = (document.getElementById('p-name') as HTMLInputElement).value.trim();
        const email = (document.getElementById('p-email') as HTMLInputElement).value.trim();
        const handle = (document.getElementById('p-handle') as HTMLInputElement).value.trim();
        const sport = (document.getElementById('p-sport') as HTMLInputElement).value.trim();
        const message = (document.getElementById('p-message') as HTMLTextAreaElement).value.trim();

        const affiliateChecked = (document.getElementById('p-type-affiliate') as HTMLInputElement).checked;
        const councilChecked = (document.getElementById('p-type-council') as HTMLInputElement).checked;
        const partnerType = affiliateChecked && councilChecked ? 'Affiliate + Athlete Council'
          : councilChecked ? 'Athlete Council'
          : 'Affiliate';

        const firstName = name.split(' ')[0];
        const lastName = name.split(' ').slice(1).join(' ');

        try {
          // Submit directly to Klaviyo client-side API — no server env vars needed
          await fetch('https://a.klaviyo.com/client/subscriptions/?company_id=TYfncY', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'revision': '2024-10-15',
            },
            body: JSON.stringify({
              data: {
                type: 'subscription',
                attributes: {
                  custom_source: 'Brand Partner Program',
                  profile: {
                    data: {
                      type: 'profile',
                      attributes: {
                        email,
                        first_name: firstName,
                        last_name: lastName,
                        properties: {
                          social_handle: handle,
                          sport,
                          partner_type: partnerType,
                          application_message: message,
                          source: 'brand-partner-application',
                        }
                      }
                    }
                  }
                },
                relationships: {
                  list: {
                    data: {
                      type: 'list',
                      id: 'UwYEZd'  // Affiliate Applications list (Pam renaming to Brand Partner Applications)
                    }
                  }
                }
              }
            })
          });
        } catch (_) {}

        form?.classList.add('hidden');
        success?.classList.remove('hidden');
      });
    </script>

  </section>
</Layout>
