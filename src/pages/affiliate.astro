---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Brand Partner Program — Purest Electrolyte" description="Join the Purest Brand Partner Program. Share what you love, earn commission, and be part of something real.">
  <section class="container py-20 max-w-3xl">

    <!-- Hero -->
    <header class="text-center mb-16">
      <p class="text-sm uppercase tracking-widest text-muted-foreground mb-4">Brand Partner Program</p>
      <h1 class="font-serif text-4xl md:text-5xl font-medium mb-6">Share what you love.<br/>Be part of the brand.</h1>
      <p class="text-lg text-muted-foreground max-w-xl mx-auto mb-8">
        Pam reviews every single one personally.
      </p>
      <a href="#apply" class="inline-block bg-foreground text-background font-semibold px-8 py-4 rounded-lg hover:opacity-80 transition-opacity">Apply Now &rarr;</a>
    </header>

    <!-- Who It's For -->
    <div class="mb-16">
      <h2 class="font-serif text-2xl font-medium mb-6">Who this is for</h2>
      <p class="text-muted-foreground mb-4 leading-relaxed">People who care about transparent ingredients, real wellness, and elevating their health. People who want to feel aligned with nature.</p>
      <p class="text-muted-foreground mb-4 leading-relaxed">Runners. Skiers. Surfers. Hikers. Coaches. CrossFitters. Cyclists. Yogis. Beach athletes. Mountain athletes. Anyone who pushes their body and cares about what goes into it.</p>
      <p class="text-muted-foreground mb-4 leading-relaxed">We don't require a certain follower count. We care about your values, your voice, and your community's trust in you. Some of our best partners have 2,000 followers and more influence than accounts with 200,000.</p>
      <p class="text-muted-foreground mb-4 leading-relaxed">What we're really building here is a community of people who believe that feeling good is effortless when you're giving your body what it actually needs.</p>
      <p class="text-muted-foreground mb-4 leading-relaxed">People who want to feel confident, feel beautiful, feel aligned.</p>
      <p class="text-muted-foreground mb-4 leading-relaxed">We want this for the people around them too.</p>
      <p class="text-muted-foreground mb-4 leading-relaxed">If that's you, we want you here.</p>
      <p class="text-muted-foreground leading-relaxed">And we want you to know that we care genuinely about every person who carries the brand.</p>
    </div>

    <!-- Benefits -->
    <div class="mb-16">
      <h2 class="font-serif text-2xl font-medium mb-8 text-center">What you get</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="border border-border rounded-xl p-6">
          <p class="font-medium mb-1">10% commission</p>
          <p class="text-sm text-muted-foreground">Earn on every sale you drive — no minimums, no caps.</p>
        </div>
        <div class="border border-border rounded-xl p-6">
          <p class="font-medium mb-1">Your own discount code</p>
          <p class="text-sm text-muted-foreground">10% off for your followers — something real to offer your community.</p>
        </div>
        <div class="border border-border rounded-xl p-6">
          <p class="font-medium mb-1">Free starter kit</p>
          <p class="text-sm text-muted-foreground">Shipped to you the day you're approved so you actually know what you're sharing.</p>
        </div>
        <div class="border border-border rounded-xl p-6">
          <p class="font-medium mb-1">Monthly payouts</p>
          <p class="text-sm text-muted-foreground">Via PayPal or Venmo, simple and direct.</p>
        </div>
        <div class="border border-border rounded-xl p-6">
          <p class="font-medium mb-1">First access to new products</p>
          <p class="text-sm text-muted-foreground">New flavors, new formats — you hear about it before anyone else.</p>
        </div>
        <div class="border border-border rounded-xl p-6">
          <p class="font-medium mb-1">Featured on purestelectrolyte.com</p>
          <p class="text-sm text-muted-foreground">Your story, your platform, on the Purest site.</p>
        </div>
        <div class="border border-border rounded-xl p-6 sm:col-span-2">
          <p class="font-medium mb-1">Direct access to Pam</p>
          <p class="text-sm text-muted-foreground">Real collaboration. You're not just a referral link. You're part of building this brand.</p>
        </div>
      </div>
    </div>



    <!-- Quote -->
    <div class="mb-16 border-l-2 border-border pl-6">
      <p class="text-lg font-serif italic text-foreground/80 leading-relaxed mb-3">
        "I started Purest because I couldn't find anything clean enough for my own kids. The people I want in this program are the ones who actually read the label."
      </p>
      <p class="text-sm text-muted-foreground">Pam Sweeney, Founder</p>
    </div>

    <!-- Apply Form -->
    <div id="apply" class="border border-border rounded-xl px-8 py-10">
      <h2 class="font-serif text-2xl font-medium mb-2">Apply to the Brand Partner Program</h2>
      <p class="text-muted-foreground text-sm mb-8">Pam reviews every application personally and responds within 3–5 days.</p>

      <form id="partner-form" class="space-y-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-medium mb-1.5" for="p-name">Your name</label>
            <input id="p-name" name="name" type="text" required placeholder="Jane Smith"
              class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5" for="p-email">Email address</label>
            <input id="p-email" name="email" type="email" required placeholder="you@example.com"
              class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20" />
          </div>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-medium mb-1.5" for="p-handle">Instagram, TikTok, or website</label>
            <input id="p-handle" name="social_handle" type="text" required placeholder="@yourhandle or yoursite.com"
              class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1.5" for="p-sport">Your sport or activity</label>
            <input id="p-sport" name="sport" type="text" placeholder="Running, skiing, surfing..."
              class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-1.5" for="p-message">Tell us about yourself</label>
          <textarea id="p-message" name="message" required rows="4" placeholder="Tell us about your community, your active life, and why Purest fits..."
            class="w-full border border-border rounded-lg px-4 py-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/20 resize-none"></textarea>
        </div>

        <button type="submit" id="p-submit"
          class="w-full bg-foreground text-background font-semibold px-8 py-4 rounded-lg hover:opacity-80 transition-opacity">
          Submit Application &rarr;
        </button>
      </form>

      <div id="partner-error" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700 text-center">
        Something went wrong — please try again or email us at <a href="mailto:pam@purestelectrolyte.com" class="underline">pam@purestelectrolyte.com</a>
      </div>

      <div id="partner-success" class="hidden text-center py-8">
        <div class="font-serif text-xl font-medium mb-2">Application received.</div>
        <p class="text-muted-foreground text-sm">Pam reads every application personally. You'll hear back within 3–5 days.</p>
      </div>
    </div>

  </section>
</Layout>

<script>
  const form = document.getElementById('partner-form');
  const success = document.getElementById('partner-success');
  const errorMsg = document.getElementById('partner-error');
  const btn = document.getElementById('p-submit') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.textContent = 'Submitting...';
    btn.setAttribute('disabled', 'true');
    errorMsg?.classList.add('hidden');

    const name = (document.getElementById('p-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('p-email') as HTMLInputElement).value.trim();
    const handle = (document.getElementById('p-handle') as HTMLInputElement).value.trim();
    const sport = (document.getElementById('p-sport') as HTMLInputElement).value.trim();
    const message = (document.getElementById('p-message') as HTMLTextAreaElement).value.trim();

    try {
      const res = await fetch('/api/partner-application', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          email,
          social_handle: handle,
          sport,
          partner_type: 'Brand Partner',
          message,
        }),
      });

      if (!res.ok) throw new Error('Server error');

      form?.classList.add('hidden');
      success?.classList.remove('hidden');
    } catch (_) {
      btn.textContent = 'Submit Application →';
      btn.removeAttribute('disabled');
      errorMsg?.classList.remove('hidden');
    }
  });
</script>
