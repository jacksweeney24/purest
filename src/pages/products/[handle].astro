---
import Layout from "@/layouts/Layout.astro";
import AddToCart from "@/components/AddToCart.tsx";
import { getProduct, getProducts } from "@/lib/shopify";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { handle: p.handle } }));
}

const { handle } = Astro.params;
const product = await getProduct(handle!);

if (!product) return Astro.redirect("/products");

const price = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: product.priceRange.minVariantPrice.currencyCode,
}).format(parseFloat(product.priceRange.minVariantPrice.amount));
---

<Layout title={`${product.title} · Purest Electrolyte`} description={product.description}>
  <section class="container py-12 md:py-16">

    <!-- Back link -->
    <a href="/products" class="text-sm text-muted-foreground hover:text-foreground mb-8 inline-block">
      ← All flavors
    </a>

    <div class="grid gap-10 md:grid-cols-2 md:items-start">

      <!-- Image gallery -->
      <div class="space-y-3">
        {product.images.length > 0 ? (
          <>
            <!-- Sliding carousel -->
            <div
              id="image-gallery"
              class="relative rounded-lg bg-white overflow-hidden w-full"
              style="aspect-ratio: 1 / 1; touch-action: pan-y; -webkit-user-select: none; user-select: none;"
            >
              <!-- Sliding track -->
              <div
                id="carousel-track"
                class="flex h-full transition-transform duration-300 ease-in-out"
                style={`width: ${product.images.length * 100}%; transform: translateX(0%);`}
              >
                {product.images.map((img: any, i: number) => (
                  <div
                    class="h-full flex-shrink-0 flex items-center justify-center bg-white"
                    style={`width: ${100 / product.images.length}%;`}
                  >
                    <img
                      src={img.url}
                      alt={img.altText ?? product.title}
                      class="w-full h-full object-contain select-none p-2"
                      draggable="false"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      style="pointer-events: none; max-width: 100%; max-height: 100%;"
                    />
                  </div>
                ))}
              </div>

              {/* Dot indicators */}
              {product.images.length > 1 && (
                <div class="absolute bottom-3 left-0 right-0 flex justify-center gap-2 pointer-events-none">
                  {product.images.map((_img: any, i: number) => (
                    <span
                      class={`dot-indicator block w-2 h-2 rounded-full transition-all duration-200 ${i === 0 ? 'bg-stone-700 scale-110' : 'bg-stone-300'}`}
                      data-index={String(i)}
                    />
                  ))}
                </div>
              )}
            </div>

            <!-- Thumbnail row -->
            {product.images.length > 1 && (
              <div class="flex gap-2 overflow-x-auto pb-1">
                {product.images.map((img: any, i: number) => (
                  <button
                    class={`flex-shrink-0 w-20 h-20 rounded-md overflow-hidden bg-white border-2 transition-colors thumbnail-btn ${i === 0 ? 'border-stone-700' : 'border-transparent hover:border-stone-400'}`}
                    data-index={String(i)}
                  >
                    <img
                      src={img.url}
                      alt={img.altText ?? product.title}
                      class="w-full h-full object-contain"
                    />
                  </button>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="aspect-square rounded-lg bg-stone-100 flex items-center justify-center">
            <span class="text-muted-foreground text-sm">No image</span>
          </div>
        )}
      </div>

      <!-- Product info -->
      <div class="space-y-6">
        <div>
          <h1 class="font-serif text-3xl tracking-tight md:text-4xl">{product.title}</h1>
          <p class="mt-3 text-2xl font-medium">{price}</p>
        </div>

        {product.descriptionHtml ? (
          <div class="text-base leading-relaxed text-foreground/75 space-y-3 prose prose-sm max-w-none" set:html={product.descriptionHtml} />
        ) : product.description ? (
          <p class="text-base leading-relaxed text-foreground/75">{product.description}</p>
        ) : null}

        <!-- Add to cart -->
        <AddToCart product={product} client:load />

        <!-- Clean label badges -->
        <div class="grid grid-cols-2 gap-2 text-sm text-foreground/60 pt-2 border-t border-border">
          <div class="flex items-center gap-2"><span>✓</span> Zero added sugar</div>
          <div class="flex items-center gap-2"><span>✓</span> No maltodextrin</div>
          <div class="flex items-center gap-2"><span>✓</span> Real fruit only</div>
          <div class="flex items-center gap-2"><span>✓</span> No junk. Ever.</div>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
  const thumbnails = Array.from(document.querySelectorAll('.thumbnail-btn')) as HTMLButtonElement[];
  const track = document.getElementById('carousel-track') as HTMLElement;
  const gallery = document.getElementById('image-gallery') as HTMLElement;
  const dots = Array.from(document.querySelectorAll('.dot-indicator')) as HTMLElement[];
  const total = thumbnails.length;
  let currentIndex = 0;

  function goToImage(index: number) {
    if (index < 0) index = total - 1;
    if (index >= total) index = 0;
    currentIndex = index;

    // Slide the track
    if (track) {
      const pct = (currentIndex / total) * 100;
      track.style.transform = `translateX(-${pct}%)`;
    }

    // Update dots
    dots.forEach((dot, i) => {
      if (i === currentIndex) {
        dot.classList.add('bg-stone-700', 'scale-110');
        dot.classList.remove('bg-stone-300');
      } else {
        dot.classList.remove('bg-stone-700', 'scale-110');
        dot.classList.add('bg-stone-300');
      }
    });

    // Update thumbnails
    thumbnails.forEach((b, i) => {
      if (i === currentIndex) {
        b.classList.add('border-stone-700');
        b.classList.remove('border-transparent');
      } else {
        b.classList.remove('border-stone-700');
        b.classList.add('border-transparent');
      }
    });
    thumbnails[currentIndex]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }

  // Thumbnail clicks
  thumbnails.forEach((btn, i) => {
    btn.addEventListener('click', () => goToImage(i));
  });

  // Touch swipe
  if (gallery) {
    let touchStartX = 0;
    let touchStartY = 0;
    let isDragging = false;

    gallery.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
      isDragging = true;
    }, { passive: true });

    gallery.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isDragging || !track) return;
      const dx = e.touches[0].clientX - touchStartX;
      const dy = e.touches[0].clientY - touchStartY;
      // If scrolling vertically, let it scroll the page
      if (Math.abs(dy) > Math.abs(dx)) return;
      const basePct = (currentIndex / total) * 100;
      const dragPct = (dx / gallery.offsetWidth) * (100 / total) * -1;
      track.style.transition = 'none';
      track.style.transform = `translateX(calc(-${basePct}% - ${dragPct * total}%))`;
    }, { passive: true });

    gallery.addEventListener('touchend', (e: TouchEvent) => {
      if (!isDragging) return;
      isDragging = false;
      track.style.transition = 'transform 300ms ease-in-out';
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
        goToImage(dx < 0 ? currentIndex + 1 : currentIndex - 1);
      } else {
        goToImage(currentIndex); // snap back
      }
    }, { passive: true });
  }
</script>
