---
import Layout from "@/layouts/Layout.astro";
import AddToCart from "@/components/AddToCart.tsx";
import { getProduct, getProducts } from "@/lib/shopify";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { handle: p.handle } }));
}

const { handle } = Astro.params;
const product = await getProduct(handle!);

if (!product) return Astro.redirect("/products");

const price = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: product.priceRange.minVariantPrice.currencyCode,
}).format(parseFloat(product.priceRange.minVariantPrice.amount));
---

<Layout title={`${product.title} · Purest Electrolyte`} description={product.description}>
  <section class="container py-12 md:py-16">

    <!-- Back link -->
    <a href="/products" class="text-sm text-muted-foreground hover:text-foreground mb-8 inline-block">
      ← All flavors
    </a>

    <div class="grid gap-10 md:grid-cols-2 md:items-start">

      <!-- Image gallery -->
      <div class="space-y-3">
        {product.images.length > 0 ? (
          <>
            <!-- Main image with swipe support -->
            <div
              id="image-gallery"
              class="aspect-square overflow-hidden rounded-lg bg-white relative"
            >
              <img
                id="main-image"
                src={product.images[0].url}
                alt={product.images[0].altText ?? product.title}
                class="w-full h-full object-contain select-none"
                draggable="false"
              />
              {product.images.length > 1 && (
                <div id="dot-indicators" class="absolute bottom-2 left-0 right-0 flex justify-center gap-1.5 pointer-events-none">
                  {product.images.map((_img: any, i: number) => (
                    <span
                      class={`dot-indicator w-1.5 h-1.5 rounded-full transition-colors ${i === 0 ? 'bg-foreground' : 'bg-foreground/30'}`}
                      data-index={String(i)}
                    />
                  ))}
                </div>
              )}
            </div>
            <!-- Thumbnail row -->
            {product.images.length > 1 && (
              <div class="flex gap-2 overflow-x-auto pb-1">
                {product.images.map((img: any, i: number) => (
                  <button
                    class={`flex-shrink-0 w-20 h-20 rounded-md overflow-hidden bg-white border-2 transition-colors thumbnail-btn ${i === 0 ? 'border-primary' : 'border-transparent hover:border-primary'}`}
                    data-src={img.url}
                    data-alt={img.altText ?? product.title}
                    data-index={String(i)}
                  >
                    <img
                      src={img.url}
                      alt={img.altText ?? product.title}
                      class="w-full h-full object-contain"
                    />
                  </button>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="aspect-square rounded-lg bg-stone-100 flex items-center justify-center">
            <span class="text-muted-foreground text-sm">No image</span>
          </div>
        )}
      </div>

      <!-- Product info -->
      <div class="space-y-6">
        <div>
          <h1 class="font-serif text-3xl tracking-tight md:text-4xl">{product.title}</h1>
          <p class="mt-3 text-2xl font-medium">{price}</p>
        </div>

        {product.descriptionHtml ? (
          <div class="text-base leading-relaxed text-foreground/75 space-y-3 prose prose-sm max-w-none" set:html={product.descriptionHtml} />
        ) : product.description ? (
          <p class="text-base leading-relaxed text-foreground/75">{product.description}</p>
        ) : null}

        <!-- Add to cart -->
        <AddToCart product={product} client:load />

        <!-- Clean label badges -->
        <div class="grid grid-cols-2 gap-2 text-sm text-foreground/60 pt-2 border-t border-border">
          <div class="flex items-center gap-2"><span>✓</span> Zero added sugar</div>
          <div class="flex items-center gap-2"><span>✓</span> No maltodextrin</div>
          <div class="flex items-center gap-2"><span>✓</span> Real fruit only</div>
          <div class="flex items-center gap-2"><span>✓</span> No junk. Ever.</div>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
  const thumbnails = Array.from(document.querySelectorAll('.thumbnail-btn')) as HTMLButtonElement[];
  const mainImg = document.getElementById('main-image') as HTMLImageElement;
  const gallery = document.getElementById('image-gallery');
  const dots = Array.from(document.querySelectorAll('.dot-indicator')) as HTMLElement[];
  let currentIndex = 0;

  function goToImage(index: number) {
    if (index < 0) index = thumbnails.length - 1;
    if (index >= thumbnails.length) index = 0;
    currentIndex = index;
    const btn = thumbnails[currentIndex];
    if (mainImg && btn) {
      mainImg.src = btn.getAttribute('data-src') || '';
      mainImg.alt = btn.getAttribute('data-alt') || '';
    }
    thumbnails.forEach(b => {
      b.classList.remove('border-primary');
      b.classList.add('border-transparent');
    });
    btn?.classList.add('border-primary');
    btn?.classList.remove('border-transparent');
    dots.forEach((dot, i) => {
      dot.classList.toggle('bg-foreground', i === currentIndex);
      dot.classList.toggle('bg-foreground/30', i !== currentIndex);
    });
    // Scroll thumbnail into view
    btn?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }

  // Thumbnail click
  thumbnails.forEach((btn, i) => {
    btn.addEventListener('click', () => goToImage(i));
  });

  // Touch swipe on main image
  if (gallery) {
    let touchStartX = 0;
    let touchStartY = 0;

    gallery.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    gallery.addEventListener('touchend', (e: TouchEvent) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      // Only register horizontal swipe if it's more horizontal than vertical
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
        if (dx < 0) goToImage(currentIndex + 1); // swipe left = next
        else goToImage(currentIndex - 1);         // swipe right = prev
      }
    }, { passive: true });
  }
</script>
