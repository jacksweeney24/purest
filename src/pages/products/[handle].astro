---
import Layout from "@/layouts/Layout.astro";
import AddToCart from "@/components/AddToCart.tsx";
import { getProduct, getProducts } from "@/lib/shopify";
import flavorCopy from "@/data/flavor-copy.json";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { handle: p.handle } }));
}

const { handle } = Astro.params;
const product = await getProduct(handle!);

if (!product) return Astro.redirect("/products");

// Extract numeric product ID from Shopify GID (e.g. gid://shopify/Product/123456)
const shopifyProductId = product.id?.split('/').pop() ?? '';

const price = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: product.priceRange.minVariantPrice.currencyCode,
}).format(parseFloat(product.priceRange.minVariantPrice.amount));
---

<Layout title={`${product.title} · Purest Electrolyte`} description={product.description}>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.title,
  "image": product.images.map((img: any) => img.url),
  "description": product.description,
  "brand": {
    "@type": "Brand",
    "name": "Purest Electrolyte"
  },
  "offers": {
    "@type": "Offer",
    "url": `https://purestelectrolyte.com/products/${product.handle}`,
    "priceCurrency": product.priceRange.minVariantPrice.currencyCode,
    "price": parseFloat(product.priceRange.minVariantPrice.amount).toFixed(2),
    "availability": "https://schema.org/InStock"
  }
})} />
  <section class="container py-12 md:py-16">

    <!-- Back link -->
    <a href="/products" class="text-sm text-muted-foreground hover:text-foreground mb-8 inline-block">
      ← All flavors
    </a>

    <div class="grid gap-10 md:grid-cols-2 md:items-start">

      <!-- Image gallery -->
      <div class="space-y-3">
        {product.images.length > 0 ? (
          <>
            <!-- Native scroll-snap carousel -->
            <div class="relative w-full rounded-lg overflow-hidden bg-white" style="aspect-ratio:1/1">
              <div
                id="image-gallery"
                class="flex w-full h-full overflow-x-scroll cursor-zoom-in"
                style="scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; -ms-overflow-style: none;"
              >
                {product.images.map((img: any, i: number) => (
                  <div
                    class="gallery-slide-wrap flex-shrink-0 w-full h-full flex items-center justify-center bg-white"
                    style="scroll-snap-align: start;"
                    data-src={img.url}
                    data-alt={img.altText ?? product.title}
                  >
                    <img
                      src={img.url}
                      alt={img.altText ?? product.title}
                      class="w-full h-full object-contain p-3"
                      draggable="false"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      style="pointer-events:none;"
                    />
                  </div>
                ))}
              </div>

              {/* Zoom hint */}
              <div class="absolute top-2 right-2 bg-black/30 text-white text-xs px-2 py-1 rounded-full pointer-events-none">
                tap to zoom
              </div>

              {/* Dot indicators */}
              {product.images.length > 1 && (
                <div class="absolute bottom-3 left-0 right-0 flex justify-center gap-2 pointer-events-none">
                  {product.images.map((_img: any, i: number) => (
                    <span
                      class={`dot-indicator block w-2 h-2 rounded-full transition-colors duration-200 ${i === 0 ? 'bg-stone-700' : 'bg-stone-300'}`}
                      data-index={String(i)}
                    />
                  ))}
                </div>
              )}
            </div>

            <!-- Lightbox overlay -->
            <div
              id="lightbox"
              class="fixed inset-0 z-50 bg-black hidden items-center justify-center"
            >
              <!-- Close -->
              <button
                id="lightbox-close"
                class="absolute top-4 right-4 z-10 text-white text-3xl leading-none w-12 h-12 flex items-center justify-center bg-black/40 rounded-full"
                aria-label="Close"
              >✕</button>
              <!-- Prev -->
              <button
                id="lightbox-prev"
                class="absolute left-3 top-1/2 -translate-y-1/2 z-10 text-white text-2xl w-12 h-12 flex items-center justify-center bg-black/40 rounded-full"
                aria-label="Previous"
              >‹</button>
              <!-- Next -->
              <button
                id="lightbox-next"
                class="absolute right-3 top-1/2 -translate-y-1/2 z-10 text-white text-2xl w-12 h-12 flex items-center justify-center bg-black/40 rounded-full"
                aria-label="Next"
              >›</button>
              <!-- Counter -->
              <div id="lightbox-counter" class="absolute bottom-4 left-0 right-0 text-center text-white/70 text-sm pointer-events-none"></div>
              <!-- Image (pinch-zoom enabled by browser) -->
              <img
                id="lightbox-img"
                src=""
                alt=""
                class="max-w-full max-h-full object-contain"
                style="touch-action: pinch-zoom;"
              />
            </div>

            <!-- Thumbnail row -->
            {product.images.length > 1 && (
              <div class="flex gap-2 overflow-x-auto pb-1">
                {product.images.map((img: any, i: number) => (
                  <button
                    class={`flex-shrink-0 w-20 h-20 rounded-md overflow-hidden bg-white border-2 transition-colors thumbnail-btn ${i === 0 ? 'border-stone-700' : 'border-transparent hover:border-stone-400'}`}
                    data-index={String(i)}
                  >
                    <img
                      src={img.url}
                      alt={img.altText ?? product.title}
                      class="w-full h-full object-contain"
                    />
                  </button>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="aspect-square rounded-lg bg-stone-100 flex items-center justify-center">
            <span class="text-muted-foreground text-sm">No image</span>
          </div>
        )}
      </div>

      <!-- Product info -->
      <div class="space-y-6">
        <div>
          <h1 class="font-serif text-3xl tracking-tight md:text-4xl">{product.title}</h1>
          <div class="mt-3 flex items-baseline gap-3">
            {handle === 'the-hydration-ritual-kit' ? (
              <>
                <span class="text-sm text-muted-foreground line-through">$66.98</span>
                <span class="text-2xl font-medium">{price}</span>
                <span class="text-sm font-medium text-green-700">Save $17.98</span>
              </>
            ) : (
              <span class="text-2xl font-medium">{price}</span>
            )}
          </div>
          <!-- Judge.me star rating badge -->
          <div class="mt-2">
            <div class="jdgm-widget jdgm-preview-badge" data-id={shopifyProductId}></div>
          </div>
        </div>

        {product.descriptionHtml ? (
          <div class="text-base leading-relaxed text-foreground/75 space-y-3 prose prose-sm max-w-none" set:html={product.descriptionHtml} />
        ) : product.description ? (
          <p class="text-base leading-relaxed text-foreground/75">{product.description}</p>
        ) : null}

        <!-- Add to cart -->
        <AddToCart product={product} client:load />

        <!-- Clean label badges -->
        <div class="grid grid-cols-2 gap-2 text-sm text-foreground/60 pt-2 border-t border-border">
          <div class="flex items-center gap-2"><span>✓</span> Zero added sugar</div>
          <div class="flex items-center gap-2"><span>✓</span> No maltodextrin</div>
          <div class="flex items-center gap-2"><span>✓</span> Real fruit only</div>
          <div class="flex items-center gap-2"><span>✓</span> No junk. Ever.</div>
        </div>

        <!-- Guarantee badge -->
        <div class="border-l-4 border-foreground pl-4 py-1 mt-2">
          <div class="text-sm font-semibold text-foreground">Satisfaction Guaranteed</div>
          <div class="text-xs text-foreground/60">Not happy? We'll make it right. No hassle, no questions.</div>
        </div>
      </div>

    </div>
  </section>

  {/* Flavor story + details section */}
  {(() => {
    const copy = (flavorCopy as any)[product.handle];
    if (!copy) return null;
    return (
      <section class="bg-stone-50 border-t border-stone-100">
        <div class="container py-12 md:py-16 grid gap-10 md:grid-cols-3">

          {/* Story */}
          <div class="md:col-span-2 space-y-8">
            {copy.badge && (
              <div class="inline-block bg-stone-900 text-stone-50 text-xs font-semibold px-3 py-1 rounded-full tracking-wide">
                {copy.badge}
              </div>
            )}
            {copy.story && (
              <div>
                <h2 class="font-serif text-2xl mb-3">The flavor</h2>
                <p class="text-foreground/70 leading-relaxed">{copy.story}</p>
              </div>
            )}
            {copy.flavorNote && (
              <div class="border-l-4 border-stone-300 pl-4">
                <p class="text-sm font-medium text-foreground/50 uppercase tracking-wider mb-1">Taste notes</p>
                <p class="text-foreground/80 italic">{copy.flavorNote}</p>
              </div>
            )}
            {copy.howToUse && (
              <div>
                <h3 class="font-serif text-xl mb-2">How to use</h3>
                <p class="text-foreground/70 leading-relaxed">{copy.howToUse}</p>
              </div>
            )}
          </div>

          {/* Best for */}
          {copy.bestFor && (
            <div>
              <h3 class="font-serif text-xl mb-4">Best for</h3>
              <ul class="space-y-2">
                {copy.bestFor.map((item: string) => (
                  <li class="flex items-center gap-2 text-foreground/70 text-sm">
                    <span class="text-stone-400">→</span> {item}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    );
  })()}

  {/* Judge.me All Reviews */}
  <section class="container py-12 border-t border-stone-100">
    <h2 class="font-serif text-2xl mb-6">Customer reviews</h2>
    <div class="jdgm-widget jdgm-all-reviews-widget" data-id={shopifyProductId}></div>
  </section>

  {/* FAQ */}
  <section class="container py-12">
    <h2 class="font-serif text-2xl mb-6">Common questions</h2>
    <div class="divide-y divide-border max-w-2xl" id="faq-list">
      {[
        { q: "How much should I use?", a: "One scoop (one serving) mixed into 12–16 oz of cold water. Most people drink 1–2 servings per day. More if you're active, sweating, or at altitude." },
        { q: "Is there any sugar in this?", a: "Zero added sugar. The sweetness comes from two sources: real freeze-dried fruit, and a small amount of stevia and monk fruit. Both are completely natural — stevia is extracted from a leaf, monk fruit comes from a melon. Neither is an artificial sweetener. What you won't find here is sucralose, aspartame, or any lab-made synthetic sweetener. Just plants." },
        { q: "How is this different from LMNT, Liquid IV, or other brands?", a: "Most electrolyte brands use 3 synthetic minerals and artificial flavors. Purest delivers 85+ trace minerals from natural sun-dried sea salt, plus real freeze-dried fruit. No artificial anything." },
        { q: "Does the subscription auto-renew?", a: "Yes — your subscription ships on your chosen schedule and can be paused or cancelled anytime with no fees. Manage it directly from your account or email us." },
        { q: "What's the free shipping threshold?", a: "Free shipping on all orders over $39. Most single jars qualify. Subscribe and it's always free." },
      ].map((item, i) => (
        <div class="faq-item py-4 cursor-pointer" data-index={String(i)}>
          <button class="w-full text-left flex justify-between items-center gap-4 font-medium">
            <span>{item.q}</span>
            <span class="faq-icon flex-shrink-0 text-foreground/40 transition-transform">+</span>
          </button>
          <div class="faq-answer hidden mt-3 text-sm text-foreground/65 leading-relaxed pr-8">{item.a}</div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  // FAQ accordion
  document.querySelectorAll('.faq-item').forEach(item => {
    item.addEventListener('click', () => {
      const answer = item.querySelector('.faq-answer') as HTMLElement;
      const icon = item.querySelector('.faq-icon') as HTMLElement;
      const isOpen = !answer.classList.contains('hidden');
      // Close all
      document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => { i.textContent = '+'; (i as HTMLElement).style.transform = 'rotate(0deg)'; });
      // Open clicked if it was closed
      if (!isOpen) {
        answer.classList.remove('hidden');
        icon.textContent = '−';
      }
    });
  });
</script>

<script>
  const gallery = document.getElementById('image-gallery') as HTMLElement;
  const thumbnails = Array.from(document.querySelectorAll('.thumbnail-btn')) as HTMLButtonElement[];
  const dots = Array.from(document.querySelectorAll('.dot-indicator')) as HTMLElement[];
  const total = thumbnails.length;

  function updateActive(index: number) {
    dots.forEach((d, i) => {
      d.classList.toggle('bg-stone-700', i === index);
      d.classList.toggle('bg-stone-300', i !== index);
    });
    thumbnails.forEach((b, i) => {
      b.classList.toggle('border-stone-700', i === index);
      b.classList.toggle('border-transparent', i !== index);
    });
    thumbnails[index]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }

  // Thumbnail clicks scroll the carousel to the right slide
  thumbnails.forEach((btn, i) => {
    btn.addEventListener('click', () => {
      if (gallery) gallery.scrollTo({ left: gallery.offsetWidth * i, behavior: 'smooth' });
      updateActive(i);
    });
  });

  // Update dots as user scrolls/swipes
  if (gallery) {
    gallery.addEventListener('scroll', () => {
      const index = Math.round(gallery.scrollLeft / gallery.offsetWidth);
      updateActive(index);
    }, { passive: true });
  }

  // Lightbox
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const slides = Array.from(document.querySelectorAll('.gallery-slide-wrap')) as HTMLElement[];
  let lightboxIndex = 0;

  function showLightboxAt(index: number) {
    if (index < 0) index = slides.length - 1;
    if (index >= slides.length) index = 0;
    lightboxIndex = index;
    const el = slides[lightboxIndex];
    if (lightboxImg) {
      lightboxImg.src = el.dataset.src || '';
      lightboxImg.alt = el.dataset.alt || '';
    }
    if (lightboxCounter) lightboxCounter.textContent = `${lightboxIndex + 1} / ${slides.length}`;
    // Hide prev/next if only 1 image
    if (lightboxPrev) lightboxPrev.style.display = slides.length > 1 ? 'flex' : 'none';
    if (lightboxNext) lightboxNext.style.display = slides.length > 1 ? 'flex' : 'none';
  }

  function openLightbox(index: number) {
    if (!lightbox) return;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
    showLightboxAt(index);
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  // Tap on slide opens lightbox
  let isScrolling = false;
  gallery?.addEventListener('scroll', () => { isScrolling = true; setTimeout(() => { isScrolling = false; }, 100); }, { passive: true });

  slides.forEach((wrap, i) => {
    wrap.addEventListener('click', () => { if (!isScrolling) openLightbox(i); });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxPrev?.addEventListener('click', () => showLightboxAt(lightboxIndex - 1));
  lightboxNext?.addEventListener('click', () => showLightboxAt(lightboxIndex + 1));
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
</script>
