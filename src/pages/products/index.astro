---
import Layout from "@/layouts/Layout.astro";
import ProductGrid from "@/components/ProductGrid.tsx";
import { getProducts } from "@/lib/shopify";

const allProducts = await getProducts();
// Match the homepage's exact seven-product merchandising order.
const productOrder = [
  '10-count-ginger-limeaid',
  '5-day-hydration-kit',
  '10-count-hibiscus-lime',
  '10-serving-passion-cherry',
  '10-count-chocolate-cordyceps-1',
  '10-servings-cranberry',
  'free-purest-glass-water-bottle',
];
const products = productOrder.flatMap(handle =>
  allProducts.filter(product => product.handle === handle)
);
---

<Layout title="Shop Real Fruit Electrolytes in Glass Jars | Purest" description="Shop real fruit electrolyte powders packaged in clear glass jars. Five flavors made with freeze-dried fruit and French gray sea salt.">
  <section class="container py-16 md:py-20">
    <header class="max-w-2xl">
      <h1 class="font-serif text-4xl tracking-tight md:text-5xl">Real fruit electrolytes in glass jars</h1>
      <p class="mt-4 text-lg text-muted-foreground">
        Shop five real fruit electrolyte flavors packaged in clear glass jars. Pick the flavor you will actually look forward to.
      </p>
    </header>

    <!-- New here? Start with Ginger LimeAid -->
    <div class="mt-8 mb-10 max-w-2xl border-l-4 border-foreground pl-5 py-1">
      <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-1">New to Purest?</p>
      <p class="font-serif font-semibold text-foreground text-lg mb-1">Start with Ginger LimeAid.</p>
      <p class="text-muted-foreground text-sm">
        Not sure which flavor to pick? <strong class="text-foreground">Ginger LimeAid</strong> is our #1 best seller and the one Pam drinks every morning. Most people start there and never look back.
        <a href="/products/10-count-ginger-limeaid" class="ml-1 text-foreground font-semibold underline underline-offset-2 hover:opacity-70">Try Ginger LimeAid →</a>
      </p>
    </div>

    <div class="mt-4">
      {/* client:load is required because ProductCard's add-to-cart button is interactive. */}
      <ProductGrid products={products} client:load />
    </div>
  </section>
</Layout>
