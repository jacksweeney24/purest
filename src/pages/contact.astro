---
import Layout from "@/layouts/Layout.astro";

const contactEmail = "hydrate@purestelectrolyte.com";
---

<Layout title="Contact · Purest Electrolyte" description="Get in touch with Purest Electrolyte. Pam reads every message personally.">
  <section class="container max-w-5xl py-20 md:py-28">
    <header class="mx-auto max-w-2xl text-center">
      <p class="text-xs uppercase tracking-widest text-muted-foreground">Get in touch</p>
      <h1 class="mt-4 font-serif text-4xl tracking-tight md:text-5xl">
        We'd love to hear from you.
      </h1>
      <p class="mt-4 text-lg text-muted-foreground">
        Questions about a product, an order, wholesale, press, or anything else — just reach out.
        Pam reads every message personally.
      </p>
    </header>

    <div class="mt-12 grid gap-8 md:grid-cols-[minmax(0,1fr)_20rem] md:items-start">
      <div class="rounded-xl border border-border p-6 sm:p-8">
        <form
          id="contact-form"
          class="space-y-5"
          action={`https://formsubmit.co/${contactEmail}`}
          method="POST"
        >
          <input type="hidden" name="_subject" value="New message from the Purest Electrolyte website" />
          <input type="hidden" name="_next" value="https://www.purestelectrolyte.com/thank-you/" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="true" />
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="mb-1.5 block text-sm font-medium" for="contact-name">Your name</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                maxlength="120"
                placeholder="Your name"
                class="w-full rounded-lg border border-border bg-background px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-foreground/20"
              />
            </div>
            <div>
              <label class="mb-1.5 block text-sm font-medium" for="contact-email">Email address</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                maxlength="254"
                placeholder="you@example.com"
                class="w-full rounded-lg border border-border bg-background px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-foreground/20"
              />
            </div>
          </div>

          <div>
            <label class="mb-1.5 block text-sm font-medium" for="contact-order">
              Order number <span class="font-normal text-muted-foreground">(optional)</span>
            </label>
            <input
              id="contact-order"
              name="order_number"
              type="text"
              autocomplete="off"
              maxlength="80"
              placeholder="Order number"
              class="w-full rounded-lg border border-border bg-background px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-foreground/20"
            />
          </div>

          <div>
            <label class="mb-1.5 block text-sm font-medium" for="contact-message">How can we help?</label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="6"
              maxlength="5000"
              placeholder="Tell us what's on your mind..."
              class="w-full resize-y rounded-lg border border-border bg-background px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-foreground/20"
            ></textarea>
          </div>

          <div aria-hidden="true" class="absolute -left-[9999px] -top-[9999px] opacity-0 pointer-events-none">
            <label for="contact-honey">Leave this blank</label>
            <input id="contact-honey" name="_honey" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <button
            id="contact-submit"
            type="submit"
            class="w-full rounded-lg bg-foreground px-8 py-4 font-semibold text-background transition-opacity hover:opacity-80 disabled:cursor-wait disabled:opacity-60"
          >
            Send Message →
          </button>
        </form>

      </div>

      <aside id="email-contact" class="rounded-xl bg-secondary p-6 sm:p-8">
        <h2 class="font-serif text-2xl">Prefer email?</h2>
        <p class="mt-3 text-sm text-muted-foreground">
          Copy the address below and paste it into any email app.
        </p>
        <a
          id="contact-email-address"
          href={`mailto:${contactEmail}`}
          class="mt-5 block whitespace-nowrap text-sm font-medium tracking-tight underline-offset-2 hover:underline select-all"
        >
          {contactEmail}
        </a>
        <button
          id="copy-email"
          type="button"
          class="mt-4 w-full rounded-lg border border-border bg-background px-4 py-3 text-sm font-medium transition-colors hover:bg-muted"
        >
          Copy email address
        </button>
        <p id="copy-status" class="mt-2 min-h-5 text-center text-xs text-muted-foreground" aria-live="polite"></p>

        <div class="mt-8 border-t border-border pt-6 text-sm text-muted-foreground">
          <p>Aspen, Colorado</p>
          <p class="mt-1">Developed at 8,900 ft</p>
          <a href="https://instagram.com/purestelectrolyte" class="mt-4 inline-block underline underline-offset-2 hover:text-foreground">
            @purestelectrolyte on Instagram
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  const copyButton = document.getElementById('copy-email') as HTMLButtonElement | null;
  const copyStatus = document.getElementById('copy-status');
  const emailAddress = document.getElementById('contact-email-address')?.textContent?.trim() ?? '';

  copyButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(emailAddress);
      copyButton.textContent = 'Copied!';
      if (copyStatus) copyStatus.textContent = 'Email address copied to your clipboard.';
      window.setTimeout(() => {
        copyButton.textContent = 'Copy email address';
        if (copyStatus) copyStatus.textContent = '';
      }, 2500);
    } catch {
      if (copyStatus) copyStatus.textContent = `Copy this address: ${emailAddress}`;
    }
  });
</script>
