---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Message Sent · Purest Electrolyte"
  description="Thank you for contacting Purest Electrolyte."
>
  <section class="container flex min-h-[60vh] items-center justify-center py-20 md:py-28">
    <div class="mx-auto max-w-xl text-center">
      <p class="text-xs uppercase tracking-widest text-muted-foreground">Message sent</p>
      <h1 class="mt-4 font-serif text-4xl tracking-tight md:text-5xl">Thanks for reaching out.</h1>
      <p class="mt-5 text-lg text-muted-foreground">
        Your message has been sent to Purest Electrolyte. Pam will be in touch soon.
      </p>
      <a
        href="/products"
        class="mt-8 inline-flex rounded-lg bg-foreground px-8 py-4 font-semibold text-background transition-opacity hover:opacity-80"
      >
        Keep Shopping →
      </a>
    </div>
  </section>
</Layout>
