---
import Layout from "@/layouts/Layout.astro";
import AspenMarathonSignup from "@/components/AspenMarathonSignup.tsx";
---

<Layout
  title="Aspen Valley Marathon — Enter to Win | Purest Electrolyte"
  description="Enter for a chance to win a Purest Glass Water Bottle + Ginger LimeAid Jar. Exclusive for Aspen Valley Marathon participants."
>

  <!-- GIVEAWAY HERO -->
  <section class="bg-foreground text-background">
    <div class="container max-w-2xl py-16 md:py-24 text-center">
      <p class="text-xs uppercase tracking-widest opacity-50 mb-4">
        Aspen Valley Marathon 2026
      </p>
      <h1 class="font-serif text-4xl md:text-6xl tracking-tight leading-tight">
        A Chance<br /><em>To Win.</em>
      </h1>
      <p class="mt-4 text-base opacity-70 max-w-sm mx-auto">
        One Purest Glass Water Bottle + One Ginger LimeAid Jar — real hydration for real runners.
      </p>
      <div class="mt-8">
        <AspenMarathonSignup client:load dark={true} />
      </div>
      <p class="mt-4 text-xs opacity-40">No purchase necessary. Winner notified by email after the race.</p>
    </div>
  </section>

  <!-- Prize Products -->
  <section class="bg-background border-b border-border/20">
    <div class="container max-w-3xl py-16">
      <p class="text-xs uppercase tracking-widest text-muted-foreground text-center mb-10">What you could win</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Glass Bottle -->
        <div class="text-center">
          <div class="aspect-square overflow-hidden rounded-sm bg-stone-50 mb-4">
            <img
              src="https://cdn.shopify.com/s/files/1/0658/9864/3644/files/Screenshot2024-08-28at11.25.25AM.png?v=1760034187"
              alt="Purest Glass Water Bottle"
              class="w-full h-full object-cover"
            />
          </div>
          <p class="text-xs uppercase tracking-widest font-semibold">Purest Glass Bottle</p>
          <p class="text-xs text-muted-foreground mt-1">Hand-pierced. Dishwasher safe.</p>
        </div>
        <!-- Ginger Lime Jar -->
        <div class="text-center">
          <div class="aspect-square overflow-hidden rounded-sm bg-stone-50 mb-4">
            <img
              src="https://cdn.shopify.com/s/files/1/0658/9864/3644/files/IMG_3854.jpg?v=1777990076"
              alt="Ginger LimeAid — 10 Servings"
              class="w-full h-full object-cover"
            />
          </div>
          <p class="text-xs uppercase tracking-widest font-semibold">Ginger LimeAid</p>
          <p class="text-xs text-muted-foreground mt-1">10 servings. Real fruit. Real salt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 10% Off Bonus -->
  <section class="bg-background border-t border-border/40">
    <div class="container max-w-2xl py-16 md:py-20 text-center">
      <p class="text-xs uppercase tracking-widest text-muted-foreground mb-3">
        Just for entering
      </p>
      <h2 class="font-serif text-3xl md:text-4xl tracking-tight">
        Plus 10% off your first order.
      </h2>
      <p class="mt-3 text-base text-muted-foreground max-w-sm mx-auto">
        Enter your email above and we'll send your discount code instantly — good sitewide on any order.
      </p>
      <p class="mt-2 text-xs text-muted-foreground/60 uppercase tracking-widest">Code sent by email after entry</p>
    </div>
  </section>

  <!-- What Makes Purest Different -->
  <section class="bg-stone-50 border-t border-border/40">
    <div class="container max-w-2xl py-16 md:py-20">
      <h2 class="font-serif text-2xl md:text-3xl tracking-tight text-center mb-12">
        Real fruit. Real salt. Nothing else.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <p class="text-3xl font-serif mb-2">85+</p>
          <p class="text-sm text-muted-foreground">trace minerals from natural sun-dried sea salt</p>
        </div>
        <div>
          <p class="text-3xl font-serif mb-2">700+</p>
          <p class="text-sm text-muted-foreground">mg naturally occurring sodium per serving</p>
        </div>
        <div>
          <p class="text-3xl font-serif mb-2">0</p>
          <p class="text-sm text-muted-foreground">grams of added sugar, maltodextrin, or junk</p>
        </div>
      </div>
      <div class="mt-12 text-center">
        <p class="text-sm text-muted-foreground italic max-w-lg mx-auto">
          "As a runner of many years, I thought I had my hydration figured out.
          It wasn't until I added Purest that I realized how depleted I had been."
        </p>
        <p class="text-xs text-muted-foreground mt-2">— Nick, Austin TX</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-background border-t border-border/40">
    <div class="container max-w-xl py-16 text-center">
      <h2 class="font-serif text-2xl tracking-tight">
        Hydrate like you mean it.
      </h2>
      <p class="mt-3 text-sm text-muted-foreground">
        Five flavors. Made in Aspen. Try the 5-Day Kit and find your favorite.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/products"
          class="inline-flex items-center justify-center rounded-full bg-foreground text-background px-8 py-3 text-sm font-medium hover:opacity-90 transition-opacity"
        >
          Shop all flavors →
        </a>
      </div>
      <p class="mt-6 text-xs text-muted-foreground/50 max-w-sm mx-auto">
        No purchase necessary. Purchase does not increase chances of winning.
        Purest Electrolyte · Aspen, Colorado
      </p>
    </div>
  </section>

</Layout>
