---
import Layout from "@/layouts/Layout.astro";
import LaJollaSignup from "@/components/LaJollaSignup.tsx";
---

<Layout
  title="La Jolla Half Marathon — Purest Electrolyte"
  description="Real hydration for real runners. Exclusive offer for La Jolla Half Marathon 2026 participants."
>
  <!-- Hero -->
  <section class="bg-background border-b border-border/40">
    <div class="container max-w-3xl py-16 md:py-24 text-center">
      <p class="text-xs uppercase tracking-widest text-muted-foreground mb-4">
        La Jolla Half Marathon 2026
      </p>
      <h1 class="font-serif text-4xl md:text-6xl tracking-tight leading-tight">
        Hydration for<br /><em>real recovery.</em>
      </h1>
      <p class="mt-6 text-base md:text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
        Real freeze-dried fruit. French gray sea salt. 85+ trace minerals.
        Nothing synthetic, nothing hidden. Made in Aspen, Colorado — and
        tested at 8,900 feet.
      </p>
      <div class="mt-8">
        <img
          src="/images/product-lineup.jpg"
          alt="Purest Electrolyte jars — real fruit, real salt"
          class="mx-auto rounded-sm w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Race Day Offer -->
  <section class="bg-foreground text-background">
    <div class="container max-w-2xl py-12 md:py-16 text-center">
      <p class="text-xs uppercase tracking-widest opacity-60 mb-3">
        Exclusive for La Jolla Runners
      </p>
      <h2 class="font-serif text-3xl md:text-4xl tracking-tight">
        10% off your online order
      </h2>
      <p class="mt-3 text-base opacity-75">
        Use code at checkout — good for any order on our site.
      </p>
      <div class="mt-6 inline-block bg-background text-foreground rounded-sm px-8 py-4">
        <p class="text-xs uppercase tracking-widest text-muted-foreground mb-1">Your race code</p>
        <p class="font-serif text-3xl tracking-widest font-medium">LAJOLLA10</p>
      </div>
      <div class="mt-8">
        <a
          href="/products"
          class="inline-flex items-center justify-center rounded-full bg-background text-foreground px-8 py-3 text-sm font-medium hover:opacity-90 transition-opacity"
        >
          Shop now →
        </a>
      </div>
    </div>
  </section>

  <!-- Giveaway / Email Capture -->
  <section class="bg-background">
    <div class="container max-w-2xl py-16 md:py-20 text-center">
      <p class="text-xs uppercase tracking-widest text-muted-foreground mb-3">
        La Jolla Half Marathon 2026
      </p>
      <h2 class="font-serif text-3xl md:text-4xl tracking-tight">
        Win The Hydration Ritual Kit
      </h2>
      <p class="mt-2 text-lg text-muted-foreground font-medium">A $59 value. Yours free.</p>
      <p class="mt-4 text-base text-muted-foreground max-w-md mx-auto">
        Enter your email below to register. One winner will be selected after race day
        and contacted directly. Everyone who enters also receives a free post-race
        recovery guide.
      </p>
      <div class="mt-8">
        <LaJollaSignup client:load />
      </div>
      <p class="mt-4 text-xs text-muted-foreground">No purchase necessary. Winner notified by email after May 16, 2026.</p>
    </div>
  </section>

  <!-- What Makes Purest Different -->
  <section class="bg-stone-50 border-t border-border/40">
    <div class="container max-w-2xl py-16 md:py-20">
      <h2 class="font-serif text-2xl md:text-3xl tracking-tight text-center mb-12">
        Not all electrolytes are equal.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <p class="text-3xl font-serif mb-2">85+</p>
          <p class="text-sm text-muted-foreground">trace minerals from natural sun-dried sea salt</p>
        </div>
        <div>
          <p class="text-3xl font-serif mb-2">700+</p>
          <p class="text-sm text-muted-foreground">mg naturally occurring sodium per serving</p>
        </div>
        <div>
          <p class="text-3xl font-serif mb-2">0</p>
          <p class="text-sm text-muted-foreground">grams of added sugar, maltodextrin, or junk</p>
        </div>
      </div>
      <div class="mt-12 text-center">
        <p class="text-sm text-muted-foreground italic max-w-lg mx-auto">
          "As a runner of many years, I thought I had my hydration figured out.
          It wasn't until I added Purest to my daily regimen that I realized how
          dehydrated I had been."
        </p>
        <p class="text-xs text-muted-foreground mt-2">— Nick, Austin TX</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-background border-t border-border/40">
    <div class="container max-w-xl py-16 text-center">
      <h2 class="font-serif text-2xl tracking-tight">
        Try the 5-Day Hydration Kit
      </h2>
      <p class="mt-3 text-sm text-muted-foreground">
        Five flavors. Five days. Find your favorite — then never run dry again.
        Use <strong>LAJOLLA10</strong> for 10% off.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/products/20-count-variety-pack"
          class="inline-flex items-center justify-center rounded-full bg-foreground text-background px-8 py-3 text-sm font-medium hover:opacity-90 transition-opacity"
        >
          Shop the 5-Day Kit — $15.99
        </a>
        <a
          href="/products"
          class="inline-flex items-center justify-center rounded-full border border-foreground/20 text-foreground px-8 py-3 text-sm font-medium hover:bg-foreground/5 transition-colors"
        >
          See all flavors
        </a>
      </div>
    </div>
  </section>
</Layout>
