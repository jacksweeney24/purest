---
import Layout from "@/layouts/Layout.astro";
import LaJollaSignup from "@/components/LaJollaSignup.tsx";
---

<Layout
  title="La Jolla Half Marathon — Purest Electrolyte"
  description="Real hydration for real runners. Exclusive offer for La Jolla Half Marathon 2026 participants."
>

  <!-- GIVEAWAY HERO — First thing they see -->
  <section class="bg-foreground text-background">
    <div class="container max-w-2xl py-16 md:py-24 text-center">
      <p class="text-xs uppercase tracking-widest opacity-50 mb-4">
        La Jolla Half Marathon 2026
      </p>
      <h1 class="font-serif text-4xl md:text-6xl tracking-tight leading-tight">
        Enter to win<br /><em>The Hydration<br />Ritual Kit.</em>
      </h1>
      <p class="mt-4 text-base opacity-70 max-w-sm mx-auto">
        A $59 value — The Hydration Ritual Kit includes our 5-Day Kit, a full jar, and the Purest glass bottle.
      </p>
      <div class="mt-8">
        <LaJollaSignup client:load dark={true} />
      </div>
      <p class="mt-4 text-xs opacity-40">No purchase necessary. Winner notified by email after May 16, 2026.</p>
    </div>
  </section>

  <!-- Product Image — large, single, clean -->
  <section class="bg-background">
    <img
      src="/images/hydration-ritual-kit.jpg"
      alt="The Hydration Ritual Kit — Purest Electrolyte"
      class="w-full object-cover max-h-[600px]"
    />
  </section>

  <!-- Race Day Discount Code -->
  <section class="bg-background border-t border-border/40">
    <div class="container max-w-2xl py-16 md:py-20 text-center">
      <p class="text-xs uppercase tracking-widest text-muted-foreground mb-3">
        Exclusive for La Jolla Runners
      </p>
      <h2 class="font-serif text-3xl md:text-4xl tracking-tight">
        10% off your order. Today.
      </h2>
      <p class="mt-3 text-base text-muted-foreground max-w-sm mx-auto">
        Use this code at checkout — good sitewide, any order.
      </p>
      <div class="mt-6 inline-block bg-foreground text-background rounded-sm px-8 py-5">
        <p class="text-xs uppercase tracking-widest opacity-60 mb-1">Your race code</p>
        <p class="font-serif text-4xl tracking-widest font-medium">LAJOLLA10</p>
      </div>
      <div class="mt-8">
        <a
          href="/products"
          class="inline-flex items-center justify-center rounded-full bg-foreground text-background px-8 py-3 text-sm font-medium hover:opacity-90 transition-opacity"
        >
          Shop now →
        </a>
      </div>
    </div>
  </section>

  <!-- What Makes Purest Different -->
  <section class="bg-stone-50 border-t border-border/40">
    <div class="container max-w-2xl py-16 md:py-20">
      <h2 class="font-serif text-2xl md:text-3xl tracking-tight text-center mb-12">
        Real fruit. Real salt. Nothing else.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <p class="text-3xl font-serif mb-2">85+</p>
          <p class="text-sm text-muted-foreground">trace minerals from natural sun-dried sea salt</p>
        </div>
        <div>
          <p class="text-3xl font-serif mb-2">700+</p>
          <p class="text-sm text-muted-foreground">mg naturally occurring sodium per serving</p>
        </div>
        <div>
          <p class="text-3xl font-serif mb-2">0</p>
          <p class="text-sm text-muted-foreground">grams of added sugar, maltodextrin, or junk</p>
        </div>
      </div>
      <div class="mt-12 text-center">
        <p class="text-sm text-muted-foreground italic max-w-lg mx-auto">
          "As a runner of many years, I thought I had my hydration figured out.
          It wasn't until I added Purest that I realized how depleted I had been."
        </p>
        <p class="text-xs text-muted-foreground mt-2">— Nick, Austin TX</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-background border-t border-border/40">
    <div class="container max-w-xl py-16 text-center">
      <h2 class="font-serif text-2xl tracking-tight">
        Try the 5-Day Hydration Kit
      </h2>
      <p class="mt-3 text-sm text-muted-foreground">
        Five flavors. Five days. Find your favorite — then never run dry again.
        Use <strong>LAJOLLA10</strong> for 10% off.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/products/20-count-variety-pack"
          class="inline-flex items-center justify-center rounded-full bg-foreground text-background px-8 py-3 text-sm font-medium hover:opacity-90 transition-opacity"
        >
          Shop the 5-Day Kit — $15.99
        </a>
        <a
          href="/products"
          class="inline-flex items-center justify-center rounded-full border border-foreground/20 text-foreground px-8 py-3 text-sm font-medium hover:bg-foreground/5 transition-colors"
        >
          See all flavors
        </a>
      </div>
    </div>
  </section>

</Layout>
