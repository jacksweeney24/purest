---
import Layout from "@/layouts/Layout.astro";
import SaleBanner from "@/components/SaleBanner.astro";
import Hero from "@/components/Hero.astro";
import ProductGrid from "@/components/ProductGrid.tsx";
import SubscriptionCTA from "@/components/SubscriptionCTA.astro";
import Testimonials from "@/components/Testimonials.astro";
import { getProducts } from "@/lib/shopify";
import FounderStory from "@/components/FounderStory.astro";
import Dehydration from "@/components/Dehydration.astro";
import Comparison from "@/components/Comparison.astro";
import StatsBar from "@/components/StatsBar.astro";
import WhatsInside from "@/components/WhatsInside.astro";
import PressBar from "@/components/PressBar.astro";

const products = await getProducts();
// Price anchor order: $15.99 kit first → $25.99 jars → $59 bundle → remaining flavors → bottle last
const kit = products.filter(p => p.handle === '20-count-variety-pack');
const ginger = products.filter(p => p.handle === '10-count-ginger-limeaid');
const bundle = products.filter(p => p.handle === 'the-hydration-ritual-kit');
const passionCherry = products.filter(p => p.handle === '10-serving-passion-cherry');
const remaining = products.filter(p =>
  !p.title.toLowerCase().includes('water bottle') &&
  p.handle !== 'the-hydration-ritual-kit' &&
  p.handle !== '20-count-variety-pack' &&
  p.handle !== '10-count-ginger-limeaid' &&
  p.handle !== '10-serving-passion-cherry'
);
const bottle = products.filter(p => p.title.toLowerCase().includes('water bottle'));
const orderedProducts = [...kit, ...ginger, ...bundle, ...passionCherry, ...remaining, ...bottle];
---

<Layout
  title="Real Fruit Electrolyte in a Glass Jar | Purest Electrolyte"
  description="Purest is a real fruit electrolyte in a clear glass jar, made with freeze-dried fruit and French gray sea salt with no natural flavors."
>
  <SaleBanner />
  <Hero />
  <PressBar />

  <section class="container py-10 md:py-14" aria-labelledby="category-heading">
    <div class="max-w-3xl">
      <p class="text-xs uppercase tracking-widest text-muted-foreground mb-2">Visible ingredients. Nothing hidden.</p>
      <h2 id="category-heading" class="font-serif text-3xl tracking-tight md:text-4xl">The real fruit electrolyte in a glass jar</h2>
      <p class="mt-4 text-lg text-foreground/75 leading-relaxed">
        Purest combines real freeze-dried fruit with French gray sea salt and packages it in clear glass, so you can see what you are drinking. No natural flavors, no maltodextrin, and no artificial dyes.
      </p>
      <a href="/science/electrolyte-in-a-glass-jar" class="inline-block mt-5 font-medium underline underline-offset-4">Why the glass jar matters →</a>
    </div>
  </section>

  {/* ALL products right below hero — anchor target for CTA */}
  <section id="shop" class="container py-10 md:py-14">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
      <div>
        <p class="text-xs uppercase tracking-widest text-muted-foreground mb-1">New to Purest? Start with the 5-Day Kit.</p>
        <h2 class="font-serif text-2xl tracking-tight md:text-3xl">Shop all flavors</h2>
      </div>
      <a href="/products" class="text-sm underline underline-offset-4 text-muted-foreground hover:text-foreground transition-colors">See full store →</a>
    </div>
    <ProductGrid products={orderedProducts} client:load />
  </section>

  <StatsBar />

  {/* In Each Jar photo and Dehydration section removed at Pam's request */}
  <Comparison />
  <FounderStory />
  <SubscriptionCTA />
  <Testimonials />
</Layout>
