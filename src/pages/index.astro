---
import Layout from "@/layouts/Layout.astro";
import SaleBanner from "@/components/SaleBanner.astro";
import Hero from "@/components/Hero.astro";
import ProductGrid from "@/components/ProductGrid.tsx";
import SubscriptionCTA from "@/components/SubscriptionCTA.astro";
import Testimonials from "@/components/Testimonials.astro";
import { getProducts } from "@/lib/shopify";
import FounderStory from "@/components/FounderStory.astro";
import Dehydration from "@/components/Dehydration.astro";
import Comparison from "@/components/Comparison.astro";
import StatsBar from "@/components/StatsBar.astro";
import WhatsInside from "@/components/WhatsInside.astro";
import PressBar from "@/components/PressBar.astro";

const products = await getProducts();
// Bundle first, then 5-day kit, then flavors, then water bottle last
const bundle = products.filter(p => p.handle === 'the-hydration-ritual-kit');
const kit = products.filter(p => p.handle === '20-count-variety-pack');
const flavors = products.filter(p => !p.title.toLowerCase().includes('water bottle') && p.handle !== 'the-hydration-ritual-kit' && p.handle !== '20-count-variety-pack');
const bottle = products.filter(p => p.title.toLowerCase().includes('water bottle'));
const orderedProducts = [...bundle, ...kit, ...flavors, ...bottle];
---

<Layout>
  <SaleBanner />
  <Hero />
  <PressBar />

  {/* ALL products right below hero — LMNT style, shop without scrolling */}
  <section class="container py-10 md:py-14">
    <h2 class="font-serif text-2xl tracking-tight mb-8 md:text-3xl">Shop all flavors</h2>
    <ProductGrid products={orderedProducts} client:load />
  </section>

  <StatsBar />

  {/* In Each Jar photo and Dehydration section removed at Pam's request */}
  <Comparison />
  <FounderStory />
  <SubscriptionCTA />
  <Testimonials />
</Layout>
